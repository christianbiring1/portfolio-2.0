# Public site URL used for canonical links and rich social previews
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Existing integrations
NEXT_PUBLIC_FORM_SPREE_ID=
NEXT_PUBLIC_GA_ID=

# GitHub OAuth App (callback: https://your-domain.com/api/auth/callback/github)
GITHUB_ID=
GITHUB_SECRET=
NEXTAUTH_URL=https://your-domain.com
NEXTAUTH_SECRET=

# Only this exact GitHub username can access the article studio
ADMIN_GITHUB_LOGIN=christianbiring1

# Fine-grained token with Contents: Read and write access to this repository
GITHUB_CONTENT_TOKEN=
GITHUB_REPO_OWNER=christianbiring1
GITHUB_REPO_NAME=portfolio-2.0
GITHUB_REPO_BRANCH=main

# Values generated at https://giscus.app after enabling GitHub Discussions
NEXT_PUBLIC_GISCUS_REPO=christianbiring1/portfolio-2.0
NEXT_PUBLIC_GISCUS_REPO_ID=
NEXT_PUBLIC_GISCUS_CATEGORY=Announcements
NEXT_PUBLIC_GISCUS_CATEGORY_ID=
